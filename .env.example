# --- backend (server-side; never exposed to the browser) ---
# Supabase is the database AND the auth provider (Project Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AI hints (students) and module drafting (teachers). Optional: without a key the /api/ai/* routes return 503.
OPENAI_API_KEY=
# optional; default gpt-4o-mini
OPENAI_MODEL=
# Code execution. The local Piston container listens on port 2000 by default.
# Set a hosted Piston /api/v2 endpoint here only when intentionally using one.
PISTON_API_URL=http://localhost:2000/api/v2
PISTON_AUTH_TOKEN=
# Exact comma-separated browser origins allowed by Express and Socket.io CORS.
# Local Vite is the default when this is omitted. Production must use the exact frontend origin.
# Production: CLIENT_ORIGINS=https://saasathon2-5plpmnqdj-reuben19.vercel.app
CLIENT_ORIGINS=http://localhost:5173

# --- frontend (public; Vite only exposes VITE_-prefixed vars) ---
# Same project URL, plus the *publishable* key (sb_publishable_...) — never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local Vite development always uses its /api and /socket.io proxies. The approved
# Vercel production host has a built-in Render backend fallback. For any other
# production host, set this to the deployed backend origin (no trailing slash).
VITE_BACKEND_ORIGIN=
